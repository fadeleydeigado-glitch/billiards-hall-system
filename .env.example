# ============================================================
# 环境变量示例文件
# 用法：复制本文件为 .env，或把变量导出为本地环境变量，填入真实配置。
# 注意：.env 已被 .gitignore 忽略，不会提交到 GitHub；切勿把真实密码提交到仓库。
# ============================================================

# 必填：本地 MySQL 密码
MYSQL_PASSWORD=你的数据库密码

# 以下为可选配置（与代码默认值一致，一般无需修改，取消注释即生效）
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_DATABASE=billiards_hall
# MYSQL_PORT=3306
